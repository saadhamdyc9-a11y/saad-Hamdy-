    <!-- About Screen -->
    <string name="about_description">SnapLoad is a lightweight Android application for downloading supported media that users are authorized to save.</string>
    <string name="about_feature_1">Fast, chunked streaming engine with pause and resume</string>
    <string name="about_feature_2">Integrated Media3 hardware-accelerated video &amp; audio player</string>
    <string name="about_feature_3">100% Standalone APK with no accounts or cloud tracking</string>

    <!-- Privacy Screen -->
    <string name="privacy_heading">Your Privacy Matters</string>
    <string name="privacy_item_1">SnapLoad does not require an account.</string>
    <string name="privacy_item_2">SnapLoad does not require Firebase.</string>
    <string name="privacy_item_3">SnapLoad does not require a cloud database.</string>
    <string name="privacy_item_4">Downloaded files remain on the user\'s device.</string>
    <string name="privacy_item_5">The application does not collect unnecessary personal information.</string>
    <string name="privacy_item_6">Network requests are used only when needed for supported functionality.</string>

    <!-- Legal Screen -->
    <string name="legal_heading">Legal Notice</string>
    <string name="legal_item_1">Users are responsible for ensuring that they have permission to download and use any media they save.</string>
    <string name="legal_item_2">SnapLoad does not encourage copyright infringement.</string>
    <string name="legal_item_3">SnapLoad does not bypass DRM or access controls.</string>
    <string name="legal_item_4">Support for a source depends on that source\'s technical and legal policies.</string>

